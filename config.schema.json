{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Piccolo configuration",
  "description": "Schema for piccolo.toml schema version 1. Piccolo also checks referenced files and cross-field constraints when loading the configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment",
    "gcp"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1,
      "default": 1,
      "description": "Piccolo configuration schema version."
    },
    "environment": {
      "$ref": "#/$defs/identifier",
      "description": "Lowercase environment name."
    },
    "provider": {
      "type": "string",
      "const": "gcp",
      "default": "gcp",
      "description": "The only currently supported provider."
    },
    "spinner": {
      "type": "string",
      "enum": [
        "aesthetic",
        "arc",
        "arrow",
        "arrow2",
        "arrow3",
        "balloon",
        "balloon2",
        "betaWave",
        "binary",
        "bluePulse",
        "bounce",
        "bouncingBall",
        "bouncingBar",
        "boxBounce",
        "boxBounce2",
        "christmas",
        "circle",
        "circleHalves",
        "circleQuarters",
        "clock",
        "dots",
        "dots10",
        "dots11",
        "dots12",
        "dots13",
        "dots14",
        "dots2",
        "dots3",
        "dots4",
        "dots5",
        "dots6",
        "dots7",
        "dots8",
        "dots8Bit",
        "dots9",
        "dotsCircle",
        "dqpb",
        "dwarfFortress",
        "earth",
        "fingerDance",
        "fish",
        "fistBump",
        "flip",
        "grenade",
        "growHorizontal",
        "growVertical",
        "hamburger",
        "hearts",
        "layer",
        "line",
        "line2",
        "material",
        "mindblown",
        "monkey",
        "moon",
        "noise",
        "orangeBluePulse",
        "orangePulse",
        "pipe",
        "point",
        "pong",
        "rollingLine",
        "runner",
        "sand",
        "shark",
        "simpleDots",
        "simpleDotsScrolling",
        "smiley",
        "soccerHeader",
        "speaker",
        "squareCorners",
        "squish",
        "star",
        "star2",
        "timeTravel",
        "toggle",
        "toggle10",
        "toggle11",
        "toggle12",
        "toggle13",
        "toggle2",
        "toggle3",
        "toggle4",
        "toggle5",
        "toggle6",
        "toggle7",
        "toggle8",
        "toggle9",
        "triangle",
        "weather"
      ],
      "default": "dots",
      "description": "Built-in yaspin spinner to display for Piccolo operations."
    },
    "gcp": {
      "$ref": "#/$defs/gcp"
    },
    "bootstrap": {
      "$ref": "#/$defs/bootstrap"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "gcp": {
            "properties": {
              "ssh": {
                "not": {
                  "properties": {
                    "via_iap": {
                      "const": false
                    }
                  },
                  "required": [
                    "via_iap"
                  ]
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "gcp": {
            "properties": {
              "iap": {
                "properties": {
                  "ports": {
                    "contains": {
                      "const": 22
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "gcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "instance",
        "placement",
        "disk",
        "ssh"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$",
          "description": "Google Cloud project ID."
        },
        "auth": {
          "$ref": "#/$defs/auth"
        },
        "instance": {
          "$ref": "#/$defs/instance"
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "disk": {
          "$ref": "#/$defs/disk"
        },
        "network": {
          "$ref": "#/$defs/network"
        },
        "iap": {
          "$ref": "#/$defs/iap"
        },
        "iam": {
          "$ref": "#/$defs/iam"
        },
        "enable_apis": {
          "type": "boolean",
          "default": false
        },
        "operation_timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648,
          "default": 600
        },
        "ssh": {
          "$ref": "#/$defs/ssh"
        },
        "tunnel": {
          "$ref": "#/$defs/tunnel"
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "adc",
            "file"
          ],
          "default": "adc"
        },
        "credentials_file": {
          "type": "string",
          "default": "",
          "description": "Path to a user-controlled Google service_account or authorized_user JSON file, relative to piccolo.toml. Required when mode is file; the file must exist. SDK loading validates credential type, Google OAuth token endpoint, and googleapis.com universe; external-account and embedded impersonation JSON are unsupported."
        },
        "impersonate_service_account": {
          "type": "string",
          "default": ""
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "file"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "credentials_file": {
                "minLength": 1
              }
            },
            "required": [
              "credentials_file"
            ]
          },
          "else": {
            "properties": {
              "credentials_file": {
                "maxLength": 0
              }
            }
          }
        }
      ]
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "service_account"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "machine_type": {
          "$ref": "#/$defs/identifier",
          "default": "n2-standard-4"
        },
        "service_account": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]@[a-z][a-z0-9-]+\\.iam\\.gserviceaccount\\.com$",
          "description": "Service account email. If gcp.iam.create_service_account is true, its project portion must match gcp.project_id."
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zones"
      ],
      "properties": {
        "zones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+-[a-z]+[0-9]+-[a-z]$"
          }
        },
        "snapshot_location": {
          "$ref": "#/$defs/identifier",
          "default": "us"
        }
      }
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "size_gb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536,
          "default": 30
        },
        "type": {
          "$ref": "#/$defs/identifier",
          "default": "pd-standard"
        },
        "image": {
          "type": "string",
          "pattern": "^projects/[a-z0-9-]+/global/images/[a-z0-9-]+$"
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier",
          "default": "default"
        },
        "subnet": {
          "$ref": "#/$defs/identifier",
          "default": "default"
        },
        "subnets": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/identifier"
          },
          "default": {}
        },
        "external_ip": {
          "type": "boolean",
          "default": false,
          "description": "Explicitly opt into public addressing; private VMs need an operator-provided egress route for downloads."
        }
      }
    },
    "iap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firewall_name": {
          "$ref": "#/$defs/identifier",
          "description": "Defaults to the environment name followed by -iap."
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "default": [
            22,
            8080
          ],
          "description": "When SSH via IAP is enabled, must include port 22 and gcp.tunnel.remote_port."
        },
        "source_ranges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])/(?:[0-9]|[12][0-9]|3[0-2])$"
          },
          "default": [
            "35.235.240.0/20"
          ],
          "description": "Canonical IPv4 CIDRs contained in the IAP range 35.235.240.0/20; containment is verified by Piccolo."
        }
      }
    },
    "iam": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create_service_account": {
          "type": "boolean",
          "default": false,
          "description": "When true, gcp.instance.service_account must belong to gcp.project_id."
        },
        "secrets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "default": []
        },
        "project_roles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:roles/[A-Za-z0-9_.]+|projects/[a-z0-9-]+/roles/[A-Za-z0-9_.]+)$"
          },
          "default": [],
          "description": "Additive guest roles; Piccolo rejects basic/admin/delegation privileges and conditional-only widening."
        }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user"
      ],
      "properties": {
        "user": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
        },
        "via_iap": {
          "type": "boolean",
          "default": true
        },
        "account": {
          "type": "string",
          "default": ""
        },
        "impersonate_service_account": {
          "type": "string",
          "default": ""
        },
        "readiness_timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648,
          "default": 300
        },
        "readiness_command": {
          "type": "string",
          "default": ""
        },
        "internal_ip": {
          "type": "boolean",
          "default": false
        },
        "require_passphrase": {
          "type": "boolean",
          "default": false,
          "description": "Forward gcloud key-generation prompts in an interactive terminal; existing encrypted keys may need the SSH agent."
        },
        "expire-after": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,5}[smhd]$",
          "default": "24h",
          "description": "Finite published SSH-key access requested from gcloud for SSH and SCP; does not terminate an existing session."
        }
      }
    },
    "tunnel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remote_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8080
        },
        "local_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8080
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "script",
        "execution_user"
      ],
      "properties": {
        "script": {
          "$ref": "#/$defs/nonEmptyString",
          "description": "Path to an existing script, relative to piccolo.toml."
        },
        "remote_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)attempt-)(?!.*\\.upload-)(?!.*\\.runner\\.sh$)(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*[/]$)[A-Za-z0-9_./-]+$",
          "default": ".piccolo/bootstrap/setup.sh",
          "description": "Canonical home-relative artifact path; receipt, upload and runner names are reserved."
        },
        "execution_user": {
          "type": "string",
          "minLength": 1,
          "description": "Must equal gcp.ssh.user."
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648,
          "default": 1800
        }
      }
    }
  },
  "$comment": "Copyright 2026 Israel Flores-Arbolay; SPDX-License-Identifier: Apache-2.0"
}
